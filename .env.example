# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública (anon / publishable). NUNCA pongas aquí la service_role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-publica

# URL pública del sitio; es la que se codifica en el QR.
# En local puedes dejarla vacía (usa la URL del navegador).
NEXT_PUBLIC_SITE_URL=https://tu-workshop.vercel.app
